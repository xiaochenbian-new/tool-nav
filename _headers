# Cloudflare Pages 头部配置
# HTML / 清单 / SW 不缓存，保证更新及时；vendor 仅作弱网辅助，真正离线靠 IndexedDB 物理下载
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN

# 第三方库 —— 短缓存即可（优先走 IndexedDB 本地文件）
/vendor/*
  Cache-Control: public, max-age=3600

# 工具页 HTML —— 不缓存
/pages/*
  Cache-Control: no-cache

# 主入口 / 404 / 清单 / SW —— 不缓存
/index.html
  Cache-Control: no-cache

/404.html
  Cache-Control: no-cache

/asset-manifest.json
  Cache-Control: no-cache

/sw.js
  Cache-Control: no-cache
